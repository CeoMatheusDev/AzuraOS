.{
    // The package name used when another package depends on this one.
    .name = .azuraos,
    // Semantic Version. AzuraOS is pre-1.0: the internal milestones use
    // 0.x.y until the system is mature enough to justify a 1.0.0-alpha.1
    // pre-release. See docs/STATUS.txt.
    .version = "0.1.0",
    // Globally unique package identifier. Generated by the Zig toolchain and
    // never changed afterwards.
    .fingerprint = 0x886c47d943ab1d0e,
    // The exact toolchain the project is developed and validated against.
    .minimum_zig_version = "0.17.0",
    // No runtime dependency is linked into the kernel or the bootloader.
    // The build only uses the Zig standard library.
    .dependencies = .{},
    // Files included in the package hash.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "boot",
        "kernel",
        "shared",
        "tools",
        "tests",
        "docs",
        "README.md",
        "CHANGELOG.md",
        "AGENTS.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
    },
}
